{
  "manifest_version": 3,
  "name": "Gravador de Reunião → MP3",
  "version": "0.9.1",
  "description": "Grava o áudio do sistema (qualquer app) + microfone e exporta um MP3 para resumir no Gemini. Lembrete flutuante no Meet/Teams.",
  "permissions": ["tabCapture", "desktopCapture", "offscreen", "downloads", "downloads.open", "storage", "unlimitedStorage", "activeTab", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.teams.microsoft.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gravar reunião",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.teams.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
